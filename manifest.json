{
  "manifest_version": 3,
  "name": "NocTimer",
  "description": "Temporizador com tema Dracula para tarefas de estudo e trabalho",
  "version": "1.0.0",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ]
}
